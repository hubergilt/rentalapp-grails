# Copy this file to `.env` and fill in real values.
# .env is loaded by Application.groovy's own loadDotEnv() (not a third-party
# library — see the comment there for why) — nothing here is ever hardcoded
# in application.yml or committed with real credentials.

# --------------------------------------------------------------------------
# Database connection
# Set DB_ENGINE to whichever database you're actually running locally — it's
# the one switch Application.groovy uses to pick the JDBC driver, Hibernate
# dialect, and URL format (see ENGINE_DATASOURCE_DEFAULTS there). Then
# uncomment the matching block below for connection details, and leave the
# other engines' blocks commented out. All four engines have their JDBC
# driver declared in build.gradle, so any of them works out of the box.
# DB_NAME/DB_USERNAME/DB_PASSWORD/DB_HOST are shared by all engines.
# (rentaldb's schema is owned/migrated by Flyway — NOT by Grails.)
# --------------------------------------------------------------------------
DB_ENGINE=mysql
DB_NAME=rentaldb
DB_USERNAME=rentalapp
DB_PASSWORD=huber
DB_HOST=localhost

# --- MySQL (active) ---
DB_PORT=3306
# If your local MySQL is only reachable through a Unix socket (e.g. started
# via an environment-modules `module load mysql/8.x` setup rather than the
# OS package), uncomment the line matching your installed version —
# DB_SOCKET takes priority over DB_HOST/DB_PORT when set:
#DB_SOCKET=/var/run/mysqld/mysqld-5.7.44.sock
#DB_SOCKET=/var/run/mysqld/mysqld-8.0.45.sock

# --- PostgreSQL ---
#DB_PORT=5432

# --- Oracle ---
#DB_PORT=1521
#DB_SERVICE_NAME=rentaldb

# --- SQL Server ---
#DB_PORT=1433
#DB_ENCRYPT=true
#DB_TRUST_SERVER_CERTIFICATE=true

# Or skip all of the above and give a fully-formed JDBC URL directly
# (DB_ENGINE still selects the driver/dialect used to talk to it):
# DB_URL=jdbc:postgresql://localhost:5432/rentaldb
DB_URL=

# Log Hibernate SQL (dev debugging only — leave false/unset in production)
DB_LOG_SQL=WARN

# --- App branding (grails-app/views/layouts/main.gsp) ---
APP_NAME=RentalApp
APP_TAGLINE=Rooms, tenants & rent — all in one place
APP_THEME=slate

# --- Login (simple form-based auth gating the scaffolded admin/CRUD UI) ---
ADMIN_USERNAME=rentalapp
# Generate with `./gradlew hashPassword -Ppassword='...'` (see README, "Setting the admin password")
# — never store the plaintext password anywhere, including this file.
ADMIN_PASSWORD_HASH='$2a$10$2kf3q2d5Wdau55H6wQl5ROjMDMqsCqrkIYbucSDjZL52SyXsrJqki'

# --- Grails runtime ---
GRAILS_ENV=development
SERVER_PORT=8080
